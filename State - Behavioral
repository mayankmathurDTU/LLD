#include <iostream>        // for cout
using namespace std;

// ----- Forward declaration -----
class Fan;                 // declare Fan before State since State uses it

// ----- State Interface -----
class State {
public:
    virtual void pressButton(Fan* fan) = 0;   // each state will define what happens on button press
    virtual ~State() = default;               // virtual destructor for proper cleanup
};

// ----- Context Class (Fan) -----
class Fan {
    State* offState;       // represents the OFF state of fan
    State* lowState;       // represents the LOW speed state
    State* highState;      // represents the HIGH speed state
    State* currentState;   // pointer to current active state

public:
    Fan();                                          // constructor initializes states
    void setState(State* s) { currentState = s; }   // change fan’s current state
    void pressButton() { currentState->pressButton(this); } // delegate action to current state

    // getters to allow state classes to switch states
    State* getOffState() { return offState; }
    State* getLowState() { return lowState; }
    State* getHighState() { return highState; }

    ~Fan();                 // destructor cleans up allocated memory
};

// ----- Concrete State: OFF -----
class OffState : public State {
public:
    void pressButton(Fan* fan) override {                     // handle button press in OFF state
        cout << "Fan turned to LOW speed.\n";                 // print current action
        fan->setState(fan->getLowState());                    // switch to LOW state
    }
};

// ----- Concrete State: LOW -----
class LowState : public State {
public:
    void pressButton(Fan* fan) override {                     // handle button press in LOW state
        cout << "Fan turned to HIGH speed.\n";                // print current action
        fan->setState(fan->getHighState());                   // switch to HIGH state
    }
};

// ----- Concrete State: HIGH -----
class HighState : public State {
public:
    void pressButton(Fan* fan) override {                     // handle button press in HIGH state
        cout << "Fan turned OFF.\n";                          // print current action
        fan->setState(fan->getOffState());                    // switch back to OFF state
    }
};

// ----- Fan Constructor -----
Fan::Fan() {
    offState = new OffState();        // create OFF state
    lowState = new LowState();        // create LOW state
    highState = new HighState();      // create HIGH state
    currentState = offState;          // fan starts OFF
}

// ----- Fan Destructor -----
Fan::~Fan() {
    delete offState;                  // free memory for OFF state
    delete lowState;                  // free memory for LOW state
    delete highState;                 // free memory for HIGH state
}

// ----- Demo -----
int main() {
    Fan fan;              // create fan object (starts in OFF)
    fan.pressButton();    // OFF → LOW
    fan.pressButton();    // LOW → HIGH
    fan.pressButton();    // HIGH → OFF
    return 0;
}
