#include <iostream>
using namespace std;

class WeightMachine {  // Target interface (client wants weight in KG)
public:
    virtual float getWeightInKg() = 0;  // Function to return weight in kilograms
    virtual ~WeightMachine() = default; // Virtual destructor for cleanup
};

class WeightMachineInPounds {  // Adaptee (old machine gives weight in pounds)
public:
    float getWeightInPounds() { return 220.0f; }  // Returns weight in pounds (example value)
};

class WeightMachineAdapter : public WeightMachine {  // Adapter (converts pounds → KG)
    WeightMachineInPounds* machine;  // Holds reference to old pounds machine
public:
    WeightMachineAdapter(WeightMachineInPounds* m) : machine(m) {}  // Constructor connects adapter to old machine

    float getWeightInKg() override {  // Client calls this to get weight in KG
        float pounds = machine->getWeightInPounds();  // Get pounds from old machine
        return pounds * 0.453592f;  // Convert pounds to KG (1 pound = 0.453592 kg)
    }
};

int main() {
    WeightMachineInPounds* oldMachine = new WeightMachineInPounds();  // Create old machine (works in pounds)
    WeightMachine* adapter = new WeightMachineAdapter(oldMachine);    // Create adapter to convert pounds → KG
    cout << "Weight in KG: " << adapter->getWeightInKg() << endl;     // Client uses adapter to get result in KG
    delete adapter;  // Free adapter memory
    delete oldMachine;  // Free old machine memory
    return 0;  // Program ends
}
