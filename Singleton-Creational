Eager Singleton : singleton instance is created at program startup, before anyone asks for it.--->>Simple, inherently thread-safe.

#include <bits/stdc++.h>
using namespace std;

class Singleton {
    inline static Singleton obj;              // ✅ Eagerly created Singleton instance (created at program start)
    Singleton() {}                            // private constructor — prevents creating new objects from outside
    Singleton(const Singleton& obj) = delete; // disable copy constructor (no copying allowed)
    Singleton& operator=(const Singleton& obj) = delete; // disable assignment (no reassignment)

public:
    static Singleton* getObj() {              // global access point for Singleton
        return &obj;                          // return the address of the already created instance
    }
};

