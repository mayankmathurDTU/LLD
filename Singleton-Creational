Meyers Singleton (Lazy + Static Local Variable) : Object is created only when getInstance() is first called. : Lazy, thread-safe, no manual mutex.

#include <bits/stdc++.h>
using namespace std;

class Singleton {
    Singleton() {}                                       // private constructor — prevents external object creation
    Singleton(const Singleton& obj) = delete;            // disable copy constructor (no copying)
    Singleton& operator=(const Singleton& obj) = delete; // disable assignment (no reassignment)

public:
    static Singleton* getObj() {                         // global access point to get the Singleton instance
        static Singleton obj;                            // ✅ static local variable — created only once (lazy)
        return &obj;                                     // return the same instance every time
    }
};

