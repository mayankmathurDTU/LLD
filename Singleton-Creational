Double-Checked Locking

#include <bits/stdc++.h>
using namespace std;

class Singleton {
    inline static unique_ptr<Singleton> obj = nullptr;   // holds the single instance (initially null)
    inline static mutex m;                               // ensures thread-safe creation
    Singleton() {}                                       // private constructor to prevent outside creation
    Singleton(const Singleton& obj) = delete;            // disable copy constructor
    Singleton& operator=(const Singleton& obj) = delete; // disable assignment operator

public:
    static Singleton* getObject() {                      // global access point for the instance
        if (obj == nullptr) {                            // first check (fast path, no locking)
            unique_lock<mutex> lock(m);                  // lock to prevent race condition
            if (obj == nullptr) {                        // second check (inside lock for safety)
                obj = make_unique<Singleton>();          // create the Singleton instance
                return obj.get();                        // return pointer to the new instance
            }
        }
        return obj.get();                                // return already created instance
    }

    ~Singleton() = default;                              // public destructor so unique_ptr can delete it
};

