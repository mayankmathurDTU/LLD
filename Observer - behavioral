#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
using namespace std;

// ---------- Observer Interface ----------
class Observer {
public:
    virtual void update(string productName, int stock) = 0; // called when stock changes
    virtual ~Observer() {} // virtual destructor
};

// ---------- Subject (Product) ----------
class Product {
    string name;                        // product name
    int stock;                          // available stock
    vector<Observer*> observers;        // list of observers (users)

public:
    Product(string n, int s) : name(n), stock(s) {} // constructor

    void attach(Observer* obs) {                     // add a new observer
        observers.push_back(obs);
    }

    void detach(Observer* obs) {                     // remove an observer
        observers.erase(remove(observers.begin(), observers.end(), obs), observers.end());
    }

    void notify() {                                  // notify all observers
        for (auto obs : observers) {
            obs->update(name, stock);
        }
    }

    void setStock(int s) {                           // change stock and notify observers
        stock = s;
        notify();                                    // trigger update notifications
    }

    string getName() { return name; }
    int getStock() { return stock; }
};

// ---------- Concrete Observer (User) ----------
class User : public Observer {
    string email;                                   // user identifier (e.g., email)
public:
    User(string e) : email(e) {}

    void update(string productName, int stock) override {
        cout << "Notification to " << email << ": " 
             << productName << " stock updated to " << stock << "\n";
    }
};

// ---------- Example Usage ----------
int main() {
    Product pencil("Apsara Pencil", 0);             // product starts with 0 stock

    User u1("ram@gmail.com");                       // create users
    User u2("shyam@gmail.com");

    pencil.attach(&u1);                             // users subscribe to notifications
    pencil.attach(&u2);

    pencil.setStock(10);                            // update stock → notifies both
    pencil.setStock(20);                            // update stock again

    pencil.detach(&u1);                             // ram unsubscribes

    pencil.setStock(30);                            // only shyam gets notified now

    return 0;
}


