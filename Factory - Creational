NOTIFICATION SERVICE

#include <iostream>        // for cout
#include <memory>          // for unique_ptr
#include <string>          // for string
using namespace std;

// ---------- Step 1: Base Interface ----------
class Notifier {                              // Abstract class for all notifiers
public:
    virtual void send(string msg) = 0;        // Every notifier must implement send()
    virtual ~Notifier() {}                    // Virtual destructor
};

// ---------- Step 2: Concrete Classes ----------
class EmailNotifier : public Notifier {       // Sends Email notification
public:
    void send(string msg) override {
        cout << "Sending Email: " << msg << endl;
    }
};

class SMSNotifier : public Notifier {         // Sends SMS notification
public:
    void send(string msg) override {
        cout << "Sending SMS: " << msg << endl;
    }
};

class PushNotifier : public Notifier {        // Sends Push notification
public:
    void send(string msg) override {
        cout << "Sending Push Notification: " << msg << endl;
    }
};

// ---------- Step 3: Factory ----------
class NotifierFactory {                       // Factory to create correct Notifier
public:
    static unique_ptr<Notifier> createNotifier(const string &type) {  // Static method
        if (type == "Email") return make_unique<EmailNotifier>();     // Create EmailNotifier
        else if (type == "SMS") return make_unique<SMSNotifier>();    // Create SMSNotifier
        else if (type == "Push") return make_unique<PushNotifier>();  // Create PushNotifier
        else return nullptr;                                          // Invalid input
    }
};

// ---------- Step 4: Client Code ----------
int main() {
    auto notifier = NotifierFactory::createNotifier("Push");  // Ask factory for Push
    if (notifier) notifier->send("Your order has been shipped!");  // Use it
    return 0;
}
